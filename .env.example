NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/annu_book_store
JWT_SECRET=replace_with_a_long_random_secret

# Optional Cloudinary (if omitted, upload endpoint accepts direct image/data URL as local mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta WhatsApp Cloud API (Automated Admin Order Alerts)
# Sender Number: +91 7409852324
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=918077308953
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Gmail SMTP (Automated Customer Order Confirmation)
# Use a Google App Password (16 characters) generated from your Google Account Security settings
GMAIL_USER=ordersannubookcenter@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password_here
EMAIL_FROM=Annu Book Center <ordersannubookcenter@gmail.com>
EMAIL_REPLY_TO=ordersannubookcenter@gmail.com

APP_BASE_URL=http://localhost:3000



